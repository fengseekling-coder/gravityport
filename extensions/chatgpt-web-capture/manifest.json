{
  "manifest_version": 3,
  "name": "GravityPort Web Capture",
  "key": "",
  "version": "0.15.41",
  "description": "Archive generated images and supported Flow / Google AI Studio / Jimeng / Midjourney videos to local GravityPort.",
  "permissions": ["storage", "contextMenus", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://images.openai.com/*",
    "https://*.blob.core.windows.net/*",
    "https://gemini.google.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://aistudio.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "https://storage.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://flow-content.google/*",
    "https://jimeng.jianying.com/*",
    "https://*.byteimg.com/*",
    "https://*.jimeng.com/*",
    "https://*.vlabvod.com/*",
    "https://www.midjourney.com/*",
    "https://cdn.midjourney.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["generation-registry.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://labs.google/*",
        "https://flow.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["provider-policy.js", "provider-sites.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://jimeng.jianying.com/*"],
      "js": ["jimeng-page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://jimeng.jianying.com/*"],
      "js": ["provider-policy.js", "provider-jimeng.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://www.midjourney.com/*"],
      "js": ["provider-policy.js", "provider-midjourney.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开 GravityPort Capture 控制台"
  },
  "commands": {
    "toggle-auto-capture": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "切换 GravityPort 自动入库"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
